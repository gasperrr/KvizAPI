<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Kviz.AgeSelector"
    >
    <Border
    Stroke="LightGray"
    StrokeThickness="1"
    BackgroundColor="White"
    Padding="20"
    StrokeShape="RoundRectangle 20"
    HorizontalOptions="Center"
    VerticalOptions="Center"
    WidthRequest="300"
    HeightRequest="500"
        >

        <VerticalStackLayout x:Name="Age_Selector" Spacing="35">
            <Label Text="Izberi kategorijo!" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black" />
            <Button Text="Pionir" Clicked="OnPionirClicked" HorizontalOptions="Center" TextColor="Green" WidthRequest="180" FontSize="30" FontAttributes="Bold"/>
            <Button Text="Mladinec" Clicked="OnMladinecClicked" HorizontalOptions="Center" TextColor="Blue" WidthRequest="180" FontSize="30" FontAttributes="Bold"/>
            <Button Text="Pripravnik" Clicked="OnPripravnikClicked" HorizontalOptions="Center" TextColor="Red" WidthRequest="180" FontSize="30" FontAttributes="Bold"/>
        </VerticalStackLayout>

    </Border>
</toolkit:Popup>