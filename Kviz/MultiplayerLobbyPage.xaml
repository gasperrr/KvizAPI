<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kviz.MultiplayerLobbyPage"
             Title="MultiplayerLobbyPage">
    
    
    
    <VerticalStackLayout Padding="20">
        <Label Text="Multiplayer Quiz" FontSize="24" HorizontalOptions="Center" />
        <Entry x:Name="NameEntry" Placeholder="Enter your name" />
        <Entry x:Name="RoomCodeEntry" Placeholder="Room code (leave empty to create)" />

        <Button Text="Create Room" Clicked="OnCreateRoomClicked" />
        <Button Text="Join Room" Clicked="OnJoinRoomClicked" />
    </VerticalStackLayout>
    
</ContentPage>