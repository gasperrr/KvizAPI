<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Kviz.ResultPopup"
    Color="Transparent"
    >

    <Border
        StrokeShape="RoundRectangle 40"
        StrokeThickness="6"
        BackgroundColor="Wheat"
        Padding="20"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="400"
        HeightRequest="400"
        >
        <Border.Stroke>
            <LinearGradientBrush EndPoint="0,1">
                <GradientStop Color="Orange"
                  Offset="0.1" />
                <GradientStop Color="Brown"
                  Offset="1.0" />
            </LinearGradientBrush>
        </Border.Stroke>

        <VerticalStackLayout x:Name="AnsPopup" Spacing="20">
            <Label x:Name="TitleLabel" Text="" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black" />
            <Label x:Name="MessageLabel" Text="" HorizontalOptions="Center" TextColor="Black" FontSize="30" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" WidthRequest="350"/>
            <Button Text="Naprej" Clicked="OnCloseClicked" HorizontalOptions="Center" TextColor="Black" Padding="20" FontSize="40"/>
        </VerticalStackLayout>

    </Border>
</toolkit:Popup>
