<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Kviz.TopografskiZnakiPage"
    Shell.BackgroundColor="#d63600">
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid>
            <Label 
                Text="TOPOGRAFSKI ZNAKI"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="20"
                FontAttributes="Bold" />
        </Grid>
    </Shell.TitleView>

    <Grid>

        <!-- Main quiz layout -->
        <VerticalStackLayout Padding="20" Spacing="20"  BackgroundColor="#ffa700">

            <Grid HeightRequest="30" BackgroundColor="Transparent" x:Name="VprasanjeContainer">
                  <Label x:Name="VprasanjeText"
                         Text=""
                         FontSize="25"
                         TextColor="Black"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         FontAttributes="Bold" />
            </Grid>      
            
                <!-- Timer Display -->
            <Grid HeightRequest="30" BackgroundColor="#DDD" x:Name="TimerBarContainer">
                <BoxView x:Name="TimerBar"
                         BackgroundColor="Green"
                         HorizontalOptions="Start"
                         VerticalOptions="FillAndExpand"
                         WidthRequest="0" />

                <Label x:Name="TimerText"
                       Text="60"
                       FontSize="16"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontAttributes="Bold" />
            </Grid>

            <!-- Question -->
            <Image x:Name="QuestionImage"
HeightRequest="300"
WidthRequest="300"
Aspect="AspectFill"
HorizontalOptions="Center"
VerticalOptions="Center"/>

            <!-- Answers -->
            <VerticalStackLayout Spacing="10">

                <Button x:Name="OptionA" Text="OptionA" Clicked="OnAnswerClicked" BackgroundColor="SlateBlue" FontSize="20" FontAttributes="Bold"/>
                <Button x:Name="OptionB" Text="OptionB" Clicked="OnAnswerClicked" BackgroundColor="SlateBlue" FontSize="20" FontAttributes="Bold"/>
                <Button x:Name="OptionC" Text="OptionC" Clicked="OnAnswerClicked" BackgroundColor="SlateBlue" FontSize="20" FontAttributes="Bold"/>
                <Button x:Name="OptionD" Text="OptionD" Clicked="OnAnswerClicked" BackgroundColor="SlateBlue" FontSize="20" FontAttributes="Bold"/>
            </VerticalStackLayout>
            <Label x:Name="ScoreLabel"
       Text="Rezultat: 0"
       FontSize="40"
       HorizontalOptions="Center"
       Padding="15"
                   FontAttributes="Bold"
                   />

        </VerticalStackLayout>

        <!-- Loading overlay -->
        <StackLayout x:Name="LoadingOverlay"
                     BackgroundColor="#80000000"
                     IsVisible="False"
                     VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand"
                     Padding="20"
                     ZIndex="10">
            <ActivityIndicator IsRunning="True"
                               Color="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               WidthRequest="50"
                               HeightRequest="50" />
            <Label Text="Nalaganje..."
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />
        </StackLayout>

    </Grid>
</ContentPage>