<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Kviz.AnswerPopup"
    >

    <Border
        Stroke="LightGray"
        StrokeThickness="1"
        BackgroundColor="White"
        Padding="20"
        StrokeShape="RoundRectangle 20"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        WidthRequest="300"
        HeightRequest="200">

        <VerticalStackLayout x:Name="AnsPopup" Spacing="15">
            <Label x:Name="TitleLabel" Text="Result" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
            <Label x:Name="MessageLabel" Text="Your answer is correct!" HorizontalOptions="Center" TextColor="Black"/>
            <Button Text="Naprej" Clicked="OnCloseClicked" HorizontalOptions="Center" TextColor="Black"/>
        </VerticalStackLayout>

    </Border>
</toolkit:Popup>
