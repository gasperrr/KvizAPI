<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Kviz"
    x:Class="Kviz.KrizankaPage"
    Shell.BackgroundColor="#d63600">
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid>
            <Label 
            Text="POISCI BESEDE"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            FontSize="20"
            FontAttributes="Bold" />
        </Grid>
    </Shell.TitleView>
    
    
    <Grid BackgroundColor="#ffa700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label x:Name="WordListLabel"
               Grid.Row="0"
               Padding="10"
               FontSize="16"
               TextColor="Transparent" />

        <Grid Grid.Row="1" x:Name="ZoomPanContainer" >

            <local:PinchContainer
                     HorizontalOptions="Center"
                     VerticalOptions="Center"
                BackgroundColor="#ffa700">

                <Grid x:Name="PuzzleGrid" 
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>
            </local:PinchContainer>
            
        </Grid>

        <Grid Grid.Row="2" Padding="20">
            <Entry x:Name="WordEntry"
                   Placeholder="Vnesi besedo"
                   HorizontalOptions="Center"
                   WidthRequest="300" 
                   VerticalOptions="Center"
                   PlaceholderColor="White"
                   BackgroundColor="Green"
                   FontSize="35"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="3" Padding="20">
            <Button Text="Preveri"
                    CornerRadius="30"
                    Clicked="OnCheckWordClicked"
                    HorizontalOptions="Center" 
                    VerticalOptions="Center"
                    FontSize="30"/>
        </Grid>
    </Grid>
</ContentPage>
